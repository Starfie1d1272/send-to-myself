# 源码开发/本机构建用途：复制为 .env；根目录 Compose 默认仅监听本机并要求 HTTPS 反向代理。
# NAS 镜像安装请使用 deploy/docker-compose.yml。

# —— 必填 ——
# 登录口令（单用户）。务必设置一个强口令；留空将关闭认证（仅限本地开发）。
AUTH_PASSWORD=change-me-please

# —— 可选 ——
# 经 HTTPS 反代时保持 true；纯 HTTP 本地直连时设 false 否则 cookie 不生效
SECURE_COOKIE=true
# 回收站保留天数；0 关闭自动选取，已开始的清理仍继续。修改后需重启。
TRASH_RETENTION_DAYS=30
# 单文件上传上限（字节），默认 50MB
MAX_UPLOAD_BYTES=52428800
# 登录会话有效期（天）
SESSION_TTL_DAYS=30
